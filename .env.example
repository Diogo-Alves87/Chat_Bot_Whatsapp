# Copie este arquivo para ".env" e preencha os valores.

# ID da planilha: é o trecho entre /d/ e /edit na URL do Google Planilhas
SPREADSHEET_ID=cole_o_id_da_planilha_aqui

# Credenciais OAuth baixadas do Google Cloud (NÃO envie ao GitHub)
CREDENTIALS_FILE=credentials/credentials_bot.json
AUTHORIZED_USER_FILE=credentials/authorized_user.json

# Tempos em segundos (ajuste conforme a velocidade do seu PC/internet)
WAIT_TIME=10
TYPE_DELAY=5
AFTER_SEND_DELAY=3
BETWEEN_MESSAGES=10

# Fecha a aba do WhatsApp Web após cada envio (true/false)
CLOSE_TAB=true
